{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mona Astro: Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd site && npm run dev -- --host 0.0.0.0 --port 4321",
      "preLaunchTask": "site: install",
      "env": {
        "ASTRO_DEV_BACKGROUND": "1"
      },
      "serverReadyAction": {
        "pattern": "(?:Dev server running at|Local)\\s+https?://(?:localhost|127\\.0\\.0\\.1):4321",
        "uriFormat": "http://localhost:4321/",
        "action": "openExternally"
      }
    }
  ]
}
